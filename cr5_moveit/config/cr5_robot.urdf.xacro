<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cr5_robot">
  <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

  <!-- Unified CR5A + PGEA geometry model. The source URDF is deliberately
       geometry-only; Gazebo plugins/control tags belong to Gazebo launches. -->
  <xacro:include filename="$(find dobot_rviz)/urdf/cr5_pgea_moveit.urdf" />
  <xacro:include filename="cr5_robot.ros2_control.xacro" />
  <xacro:cr5_robot_ros2_control name="FakeSystem"
      initial_positions_file="$(arg initial_positions_file)" />
</robot>
