<?xml version="1.0"?>
<package format="3">
  <name>dobot_simulation</name>
  <version>0.1.0</version>
  <description>Simulation-only Dobot CR5A telemetry and dashboard-service adapter for MoveIt fake hardware.</description>
  <maintainer email="mohamedfaaris.dev@gmail.com">Mohamed Faaris</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>dobot_msgs_v4</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
