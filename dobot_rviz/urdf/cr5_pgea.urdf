  <!-- Connector slabs between Link6 flange and PGEA actuator body.
       Procedurally generated (disk Ø63x5 mm + plate 65x98x23 mm). All
       gripper STLs use the same mesh->link6 axis mapping - rpy=(pi/2,0,pi/2)
       i.e. mesh (x,y,z) -> link6 (y,z,x). -->
  <link name="connector_slabs">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.014"/>
      <!-- Solid aluminium plate (Ø63x5 disc + 65x98x23 plate). User
           confirmed slabs carry the gripper mounting screws — dense, not
           hollowed. Box-inertia approximation around link6 axes. -->
      <mass value="0.40"/>
      <inertia ixx="3.46e-4" ixy="0" ixz="0" iyy="1.66e-4" iyz="0" izz="4.60e-4"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/connector_slabs.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/connector_slabs.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="connector_slabs_fixed" type="fixed">
    <!-- -90° around Link6 z rotates the entire gripper assembly (slabs +
         PGEA + both fingers + TCP) so the fork extends along -link6_y,
         matching the wrist cable-port side. Same rpy applied to all four
         gripper-fixed joints + tcp_fixed below. -->
    <origin rpy="0 0 -1.5707963" xyz="0 0 0"/>
    <parent link="Link6"/>
    <child link="connector_slabs"/>
  </joint>
  <!-- PGEA-100-40 actuator body. Stacks on the connector slabs -
       wrist-mount end at body_z=0.028, slide plane at body_z=0.166. -->
  <link name="gripper_body">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.097"/>
      <!-- DH-Robotics PGEA-100-40-W mass per manufacturer spec (0.6 kg
           with or without brake). Body 56x28x138 mm centred on wrist
           axis; box-inertia approximation around link6 axes. -->
      <mass value="0.6"/>
      <inertia ixx="9.92e-4" ixy="0" ixz="0" iyy="1.11e-3" iyz="0" izz="1.96e-4"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 1.5708" xyz="0.3256 0.0028 0.100"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/PGEA-100-40-W.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 1.5708" xyz="0.3256 0.0028 0.100"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/PGEA-100-40-W.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_body_fixed" type="fixed">
    <!-- Same -90° z rotation as connector_slabs_fixed. -->
    <origin rpy="0 0 -1.5707963" xyz="0 0 0"/>
    <parent link="Link6"/>
    <child link="gripper_body"/>
  </joint>
  <link name="left_finger">
    <inertial>
      <!-- COM derived from MJCF hierarchy - finger_body_origin(0,0.025,0.166) +
           finger_inertial_in_finger(0.067,0.0165,0) = (0.067,0.0415,0.166).
           Gives link6 COM (0,-15.46,87.4) matching robot payload readout exactly. -->
      <origin rpy="0 0 0" xyz="0.067 0.0415 0.166"/>
      <mass value="0.15"/>
      <inertia ixx="2.98e-5" ixy="0" ixz="0" iyy="3.05e-4" iyz="0" izz="3.26e-4"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 1.5708" xyz="-0.0077 0.0506 0.3235"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/left_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 1.5708" xyz="-0.0077 0.0506 0.3235"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/left_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <!-- Axis "0 -1 0" is in the joint frame (= gb frame, Link6 rotated -90° z).
         -gb_y is the closing direction for the left tine (matches MJCF left_drive
         axis "0 -1 0").  limit upper=0.020 = full PGEA-100-40 half-stroke. -->
    <origin rpy="0 0 -1.5707963" xyz="0 0 0"/>
    <parent link="Link6"/>
    <child link="left_finger"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" lower="0" upper="0.020" velocity="0.5"/>
  </joint>
  <link name="right_finger">
    <inertial>
      <!-- Mirror of left_finger. COM - (0.067,-0.0415,0.166) in gb frame. -->
      <origin rpy="0 0 0" xyz="0.067 -0.0415 0.166"/>
      <mass value="0.15"/>
      <inertia ixx="2.98e-5" ixy="0" ixz="0" iyy="3.05e-4" iyz="0" izz="3.26e-4"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 1.5708" xyz="-0.0077 0.0132 0.3235"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/right_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 1.5708" xyz="-0.0077 0.0132 0.3235"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/right_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_finger_joint" type="prismatic">
    <mimic joint="left_finger_joint" multiplier="1" offset="0"/>
    <!-- Mirror of left_finger_joint - +gb_y is the closing direction for the
         right tine (matches MJCF right_drive axis "0 1 0"). -->
    <origin rpy="0 0 -1.5707963" xyz="0 0 0"/>
    <parent link="Link6"/>
    <child link="right_finger"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0" upper="0.020" velocity="0.5"/>
  </joint>
  <link name="tcp"/>
  <joint name="tcp_fixed" type="fixed">
    <!-- TCP at the centre of the hex pocket carved into both forks (the
         intended can-grasp seat). Hex flat inner face is at body_x=0.117 in
         the gripper_base frame; rotating by R_z(-π/2) into Link6 gives
         (0, -0.117, 0.180). Earlier value (0, -0.0675, 0.180) was the bare
         midpoint of the fork length — that lands the TCP in the proximal
         shaft where the inner gap is only 42 mm (a can won't fit). -->
    <origin rpy="0 0 -1.5707963" xyz="0 -0.117 0.180"/>
    <parent link="Link6"/>
    <child link="tcp"/>
  </joint>
  <gazebo reference="connector_slabs">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="gripper_body">
