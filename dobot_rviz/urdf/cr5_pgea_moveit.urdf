<?xml version='1.0' encoding='UTF-8'?>
<!--
  CR5A clean URDF for cuRobo motion planning.
  Kinematics traced from cr5a_description/cr5_robot.xacro; gazebo and
  ros2_control sections stripped, mesh paths made relative, velocity/effort
  limits filled from CR-A user guide V1.8 Appendix A. A `tcp` link is added
  at the PGEA-100-40 grasp point (verified against MJCF site `tcp`).
-->
<robot name="cr5_robot">

  <link name="world"/><link name="dummy_link"/><joint name="world_joint" type="fixed"><origin xyz="0 0 0.03" rpy="0 0 0"/><parent link="world"/><child link="dummy_link"/></joint><joint name="dummy_joint" type="fixed"><parent link="dummy_link"/><child link="base_link"/></joint><link name="base_link">
    <inertial>
      <origin xyz="0 0.003 0.029" rpy="0 0 0"/>
      <mass value="0.922"/>
      <inertia ixx="0.001552" ixy="0" ixz="0" iyy="0.001347" iyz="0" izz="0.002253"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://dobot_rviz/meshes/cr5/base_link.STL"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="package://dobot_rviz/meshes/cr5/base_link.STL"/></geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin xyz="0 -0.003 -0.008" rpy="0 0 0"/>
      <mass value="1.613"/>
      <inertia ixx="0.005468" ixy="0" ixz="0" iyy="0.005250" iyz="0" izz="0.003410"/>
    </inertial>
    <visual><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J1.STL"/></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J1.STL"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.147" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.142"/>
  </joint>

  <link name="Link2">
    <inertial>
      <origin xyz="-0.214 0 0.143" rpy="0 0 0"/>
      <mass value="5.525"/>
      <inertia ixx="0.013539" ixy="0" ixz="0" iyy="0.175351" iyz="0" izz="0.171156"/>
    </inertial>
    <visual><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J2.STL"/></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J2.STL"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 1.5708 0"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.142"/>
  </joint>

  <link name="Link3">
    <inertial>
      <origin xyz="-0.152 0 0.023" rpy="0 0 0"/>
      <mass value="2.854"/>
      <inertia ixx="0.004262" ixy="0" ixz="0.001454" iyy="0.065130" iyz="0" izz="0.064386"/>
    </inertial>
    <visual><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J3.STL"/></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J3.STL"/></geometry></collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="-0.427 -0.000349 0" rpy="0 0 0"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.792" upper="2.792" effort="150" velocity="3.142"/>
  </joint>

  <link name="Link4">
    <inertial>
      <origin xyz="0 -0.002 -0.002" rpy="0 0 0"/>
      <mass value="0.671"/>
      <inertia ixx="0.001652" ixy="0" ixz="0" iyy="0.000679" iyz="0" izz="0.001612"/>
    </inertial>
    <visual><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J4.STL"/></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J4.STL"/></geometry></collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-0.357 0.000349 0.141" rpy="0 0 -1.5708"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="60" velocity="3.892"/>
  </joint>

  <link name="Link5">
    <inertial>
      <origin xyz="0 -0.006 -0.001" rpy="0 0 0"/>
      <mass value="0.741"/>
      <inertia ixx="0.002129" ixy="0" ixz="0" iyy="0.000740" iyz="0" izz="0.002088"/>
    </inertial>
    <visual><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J5.STL"/></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J5.STL"/></geometry></collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 -0.116 0" rpy="1.5708 0 0"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="60" velocity="3.892"/>
  </joint>

  <link name="Link6">
    <inertial>
      <origin xyz="0 0 -0.019" rpy="0 0 0"/>
      <mass value="0.158"/>
      <inertia ixx="7.94e-5" ixy="0" ixz="0" iyy="7.92e-5" iyz="0" izz="1.31e-4"/>
    </inertial>
    <visual><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J6.STL"/></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_rviz/meshes/cr5/J6.STL"/></geometry></collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 0.105 0" rpy="-1.5708 0 0"/>
    <parent link="Link5"/>
    <child link="Link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="30" velocity="3.892"/>
  </joint>

  <!-- Flange + TCP frames for the PGEA-100-40 gripper. -->
  <link name="flange"/>
  <joint name="flange_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="Link6"/>
    <child link="flange"/>
  </joint>

  <!-- Connector slabs between Link6 flange and PGEA actuator body.
       Procedurally generated (disk Ø63x5 mm + plate 65x98x23 mm). All
       gripper STLs use the same mesh->link6 axis mapping: rpy=(pi/2,0,pi/2)
       i.e. mesh (x,y,z) -> link6 (y,z,x). -->
  <link name="connector_slabs">
    <inertial>
      <origin xyz="0 0 0.014" rpy="0 0 0"/>
      <!-- Solid aluminium plate (Ø63x5 disc + 65x98x23 plate). User
           confirmed slabs carry the gripper mounting screws — dense, not
           hollowed. Box-inertia approximation around link6 axes. -->
      <mass value="0.40"/>
      <inertia ixx="3.46e-4" ixy="0" ixz="0" iyy="1.66e-4" iyz="0" izz="4.60e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/connector_slabs.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/connector_slabs.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="connector_slabs_fixed" type="fixed">
    <!-- -90° around Link6 z rotates the entire gripper assembly (slabs +
         PGEA + both fingers + TCP) so the fork extends along -link6_y,
         matching the wrist cable-port side. Same rpy applied to all four
         gripper-fixed joints + tcp_fixed below. -->
    <origin xyz="0 0 0" rpy="0 0 -1.5707963"/>
    <parent link="Link6"/>
    <child link="connector_slabs"/>
  </joint>

  <!-- PGEA-100-40 actuator body. Stacks on the connector slabs:
       wrist-mount end at body_z=0.028, slide plane at body_z=0.166. -->

  <link name="gripper_body">
    <inertial>
      <origin xyz="0 0 0.097" rpy="0 0 0"/>
      <!-- DH-Robotics PGEA-100-40-W mass per manufacturer spec (0.6 kg
           with or without brake). Body 56x28x138 mm centred on wrist
           axis; box-inertia approximation around link6 axes. -->
      <mass value="0.6"/>
      <inertia ixx="9.92e-4" ixy="0" ixz="0" iyy="1.11e-3" iyz="0" izz="1.96e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.3256 0.0028 0.100" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/PGEA-100-40-W.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.3256 0.0028 0.100" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/PGEA-100-40-W.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_body_fixed" type="fixed">
    <!-- Same -90° z rotation as connector_slabs_fixed. -->
    <origin xyz="0 0 0" rpy="0 0 -1.5707963"/>
    <parent link="Link6"/>
    <child link="gripper_body"/>
  </joint>

  <link name="left_finger">
    <inertial>
      <!-- COM derived from MJCF hierarchy: finger_body_origin(0,0.025,0.166) +
           finger_inertial_in_finger(0.067,0.0165,0) = (0.067,0.0415,0.166).
           Gives link6 COM (0,-15.46,87.4) matching robot payload readout exactly. -->
      <origin xyz="0.067 0.0415 0.166" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="2.98e-5" ixy="0" ixz="0" iyy="3.05e-4" iyz="0" izz="3.26e-4"/>
    </inertial>
    <visual>
      <origin xyz="-0.0077 0.0506 0.3235" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/left_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0077 0.0506 0.3235" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/left_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <!-- Axis "0 -1 0" is in the joint frame (= gb frame, Link6 rotated -90° z).
         -gb_y is the closing direction for the left tine (matches MJCF left_drive
         axis "0 -1 0").  limit upper=0.020 = full PGEA-100-40 half-stroke. -->
    <origin xyz="0 0 0" rpy="0 0 -1.5707963"/>
    <parent link="Link6"/>
    <child link="left_finger"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.020" effort="100" velocity="0.5"/>
  </joint>

  <link name="right_finger">
    <inertial>
      <!-- Mirror of left_finger. COM: (0.067,-0.0415,0.166) in gb frame. -->
      <origin xyz="0.067 -0.0415 0.166" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="2.98e-5" ixy="0" ixz="0" iyy="3.05e-4" iyz="0" izz="3.26e-4"/>
    </inertial>
    <visual>
      <origin xyz="-0.0077 0.0132 0.3235" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/right_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0077 0.0132 0.3235" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/pgea/right_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_finger_joint" type="prismatic">
    <mimic joint="left_finger_joint" multiplier="1" offset="0"/><!-- Mirror of left_finger_joint: +gb_y is the closing direction for the
         right tine (matches MJCF right_drive axis "0 1 0"). -->
    <origin xyz="0 0 0" rpy="0 0 -1.5707963"/>
    <parent link="Link6"/>
    <child link="right_finger"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.020" effort="100" velocity="0.5"/>
  </joint>

  <link name="tcp"/>
  <joint name="tcp_fixed" type="fixed">
    <!-- TCP at the centre of the hex pocket carved into both forks (the
         intended can-grasp seat). Hex flat inner face is at body_x=0.117 in
         the gripper_base frame; rotating by R_z(-π/2) into Link6 gives
         (0, -0.117, 0.180). Earlier value (0, -0.0675, 0.180) was the bare
         midpoint of the fork length — that lands the TCP in the proximal
         shaft where the inner gap is only 42 mm (a can won't fit). -->
    <origin xyz="0 -0.117 0.180" rpy="0 0 -1.5707963"/>
    <parent link="Link6"/>
    <child link="tcp"/>
  </joint>

</robot>
